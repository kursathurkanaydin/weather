# Copy this file to ".env" and fill in your own values before running the project.
#   cp .env.example .env

# --- Database (used by the "prod" profile / docker-compose) ---
DB_NAME=weather
DB_URL=jdbc:postgresql://postgres:5432/${DB_NAME}
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Hibernate schema strategy for the prod profile.
# Keep this as "validate" in real environments - the schema itself is
# created by Flyway migrations (src/main/resources/db/migration).
DB_DDL_AUTO=validate

# --- OpenWeatherMap API ---
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# --- Spring profile ---
# "dev"  -> runs against an in-memory H2 database, no Postgres needed
# "prod" -> runs against the Postgres database configured above
SPRING_PROFILES_ACTIVE=dev
