# Copy this file to "frontend/.env" and fill in your own values before running the project.
#   cp frontend/.env.example frontend/.env
#
# There is nothing to configure by default: in dev, Vite proxies /api to
# http://localhost:8080 (see vite.config.js); in Docker, nginx proxies /api
# to the backend service (see nginx.conf). Both work without any env vars.
#
# If you need to point the frontend at a different backend URL, uncomment
# and set this (must be prefixed with VITE_ to be exposed to client code):
# VITE_API_BASE_URL=http://localhost:8080/api
